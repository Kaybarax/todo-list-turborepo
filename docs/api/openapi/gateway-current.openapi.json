        "operationId": "allApiV1*"
      },
      "post": {
        "operationId": "allApiV1*"
      },
      "put": {
        "operationId": "allApiV1*"
      },
      "delete": {
        "operationId": "allApiV1*"
      },
      "patch": {
        "operationId": "allApiV1*"
      },
      "head": {
        "operationId": "allApiV1*"
      },
      "options": {
        "operationId": "allApiV1*"
      },
      "trace": {
        "operationId": "allApiV1*"
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
