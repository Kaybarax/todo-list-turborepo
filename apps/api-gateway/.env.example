PORT=3003
PUBLIC_API_PREFIX=/api/v1
GRAPHQL_ENABLED=false
GRAPHQL_PATH=/graphql

NEST_API_URL=http://localhost:3001
BUN_API_URL=http://localhost:3002

JWT_SECRET=dev-jwt-secret-change-in-production
AUTH_VALIDATE_LOCALLY=true
AUTH_FORWARD_AUTHORIZATION=true

CORS_ORIGIN=http://localhost:3000,http://localhost:8081
CORS_CREDENTIALS=true
CORS_ALLOWED_HEADERS=content-type,authorization,x-request-id,x-api-version,x-environment,traceparent,tracestate,baggage
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

PROXY_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_REDIS_URL=
