{
  "name": "@todo/base-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "Base smart contracts for todo management on Ethereum L2",
  "scripts": {
    "compile": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js compile",
    "test": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js test",
    "test:coverage": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js coverage",
    "test:gas": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true REPORT_GAS=true hardhat --config ./hardhat.config.js test",
    "deploy:local": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js run scripts/deploy.js --network localhost",
    "deploy:dev": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js run scripts/deploy.js --network base_dev",
    "deploy:sepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js run scripts/deploy.js --network base_sepolia",
    "deploy:base": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js run scripts/deploy.js --network base",
    "verify:sepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js verify --network base_sepolia",
    "verify:base": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js verify --network base",
    "node": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js node",
    "coverage": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js coverage",
    "size": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js size-contracts",
    "lint": "solhint --config .solhint.json 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol'",
    "create-todo-list": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js run scripts/create-todo-list.js",
    "create-sample-todos": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js run scripts/create-sample-todos.js",
    "clean": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat --config ./hardhat.config.js clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0"
  },
  "devDependencies": {
    "@eth-optimism/contracts": "^0.6.0",
    "@eth-optimism/core-utils": "^0.12.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "forge-std": "github:foundry-rs/forge-std#v1.11.0",
    "hardhat": "^2.22.18",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^6.2.1",
    "solidity-coverage": "^0.8.14",
    "typechain": "^8.3.2"
  }
}
